// PesoMatch Gateway - Production Schema
// PostgreSQL (Neon)
// P0 security: hashed API keys + PINs, idempotency support

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id            String   @id @default(cuid())
  name          String
  apiKey        String   @unique // legacy plaintext (migration); prefer apiKeyHash
  apiKeyHash    String?  @unique // sha256 of full key
  apiKeyPrefix  String?  // first chars for indexed lookup
  webhookSecret String
  webhookUrl    String?
  brandName     String?
  brandEmoji    String   @default("💰")
  brandColor    String   @default("#0b6bff")
  brandFooter   String   @default("Thank you for your payment!")
  logoUrl       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gcashNumber   String?  @unique
  gcashName     String?
  pin           String?  // legacy plaintext; cleared after upgrade to pinHash
  pinHash       String?  // scrypt hash

  // GCash QR for fixed packages
  gcashQr99     String?
  gcashQr149    String?
  gcashQrUrl    String?

  // Security / ops
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?

  requests      PaymentRequest[]
  payments      Payment[]
  auditLogs     AuditLog[]

  @@index([apiKey])
  @@index([apiKeyPrefix])
  @@index([apiKeyHash])
}

model PaymentRequest {
  id                String   @id @default(cuid())
  merchantId        String
  externalId        String?
  idempotencyKey    String?
  customerName      String
  amountCentavos    Int
  baseAmount        Int
  status            String   // pending | paid | expired | review | rejected
  expiresAt         DateTime
  confirmationToken String?  @unique
  tokenConfirmedAt  DateTime?
  paidAt            DateTime?
  customerEvidence  String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  merchant          Merchant @relation(fields: [merchantId], references: [id])
  payment           Payment?
  auditLogs         AuditLog[]

  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, status])
  @@index([amountCentavos, status])
  @@index([confirmationToken])
  @@index([expiresAt])
}

model Payment {
  id              String   @id @default(cuid())
  merchantId      String
  requestId       String?  @unique
  gcashRef        String
  amountCentavos  Int
  senderName      String?
  rawSms          String?
  matchedBy       String
  matchedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  idempotencyKey  String?

  merchant        Merchant @relation(fields: [merchantId], references: [id])
  request         PaymentRequest? @relation(fields: [requestId], references: [id])

  @@unique([merchantId, gcashRef])
  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, amountCentavos])
  @@index([matchedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  merchantId  String
  requestId   String?
  actor       String
  action      String
  details     String?
  prevHash    String
  hash        String
  createdAt   DateTime @default(now())

  merchant    Merchant @relation(fields: [merchantId], references: [id])
  request     PaymentRequest? @relation(fields: [requestId], references: [id])

  @@index([merchantId, createdAt])
  @@index([requestId])
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  merchantId  String
  requestId   String
  event       String
  payload     String
  signature   String
  status      String   // pending | delivered | failed
  attempts    Int      @default(0)
  lastError   String?
  deliveredAt DateTime?
  nextAttempt DateTime?
  createdAt   DateTime @default(now())

  @@index([merchantId, status])
  @@index([requestId])
  @@index([status, nextAttempt])
}
