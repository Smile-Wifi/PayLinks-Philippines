// PesoMatch Gateway - Production Schema
// PostgreSQL (Neon) - Fixed amounts, NO TAG, Dual AI, GCash QR

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id            String   @id @default(cuid())
  name          String
  apiKey        String   @unique
  webhookSecret String
  webhookUrl    String?
  brandName     String?
  brandEmoji    String   @default("💰")
  brandColor    String   @default("#0b6bff")
  brandFooter   String   @default("Thank you for your payment!")
  logoUrl       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gcashNumber   String?  @unique
  gcashName     String?
  pin           String?

  // GCash QR for fixed packages - customer sees correct QR per amount
  gcashQr99     String?
  gcashQr149    String?
  gcashQrUrl    String?

  requests      PaymentRequest[]
  payments      Payment[]
  auditLogs     AuditLog[]

  @@index([apiKey])
}

model PaymentRequest {
  id              String   @id @default(cuid())
  merchantId      String
  externalId      String?
  customerName    String
  amountCentavos  Int      // EXACT, NO TAG: 1000=10, 1500=15, 9900=99, 14900=149
  baseAmount      Int      // same as amountCentavos (kept for compatibility)
  status          String   // pending | paid | expired | review | rejected
  expiresAt       DateTime
  confirmationToken String? @unique
  tokenConfirmedAt DateTime?
  paidAt          DateTime?
  customerEvidence String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  merchant        Merchant @relation(fields: [merchantId], references: [id])
  payment         Payment?
  auditLogs       AuditLog[]

  // REMOVED: @@unique([merchantId, amountCentavos, status]) - it blocked 2 customers buying same fixed price at same time
  @@index([merchantId, status])
  @@index([amountCentavos, status])
  @@index([confirmationToken])
  @@index([expiresAt])
}

model Payment {
  id              String   @id @default(cuid())
  merchantId      String
  requestId       String?  @unique
  gcashRef        String
  amountCentavos  Int
  senderName      String?
  rawSms          String?
  matchedBy       String
  matchedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  merchant        Merchant @relation(fields: [merchantId], references: [id])
  request         PaymentRequest? @relation(fields: [requestId], references: [id])

  @@unique([merchantId, gcashRef])
  @@index([merchantId, amountCentavos])
  @@index([matchedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  merchantId  String
  requestId   String?
  actor       String
  action      String
  details     String?
  prevHash    String
  hash        String
  createdAt   DateTime @default(now())

  merchant    Merchant @relation(fields: [merchantId], references: [id])
  request     PaymentRequest? @relation(fields: [requestId], references: [id])

  @@index([merchantId, createdAt])
  @@index([requestId])
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  merchantId  String
  requestId   String
  event       String
  payload     String
  signature   String
  status      String
  attempts    Int      @default(0)
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())

  @@index([merchantId, status])
  @@index([requestId])
}
